// Cloudflare Worker that emails the website's contact form. Setup steps are in the README.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortt-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Served only on its own subdomain; no *.workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.shorttlegacygroup.com", "custom_domain": true }],

  // Email Routing binding. It can only deliver to addresses verified in Email Routing.
  "send_email": [{ "name": "CONTACT_EMAIL" }],

  // CONTACT_TO (the inbox that receives enquiries) is a secret set in the Cloudflare dashboard.
  "vars": {
    "CONTACT_FROM": "website@shorttlegacygroup.com",
    "ALLOWED_ORIGINS": "https://shorttlegacygroup.com,https://www.shorttlegacygroup.com"
  },

  "observability": { "enabled": true }
}
